# Copy this file to .env and fill in your own keys. Never commit .env.
OPENAQ_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional backup Gemini key, ideally from a different Google project (quotas are per project). Used after the first key's models run out.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# any number more: GEMINI_API_KEY_5=..., or GEMINI_API_KEYS=key1,key2,...
# Optional: owner's demo pass that may use the reserved daily AI quota (send as X-Demo-Token). Choose your own.
DEMO_ACCESS_TOKEN=
