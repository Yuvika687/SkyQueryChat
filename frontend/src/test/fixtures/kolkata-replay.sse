data: {"status": "answered", "text": "In Kolkata, measured PM2.5 (µg/m³) averaged 45.3 with a median of 43.4 over the last 30 days (2026-10-01..2026-10-30). Levels ranged from a lowest of 12.9 on 2026-10-30 to a highest of 73 on 2026-10-06 across 7 stations.", "headline": "Kolkata's PM2.5 averaged 45.3 µg/m³ over the latest 30 days available (1–30 Oct 2026). Daily values ranged from 12.9 µg/m³ on 30 Oct to 73.0 µg/m³ on 6 Oct.", "explanation": "Measured PM: PM2.5 trend in Kolkata, 2026-10-01 to 2026-10-30. 7 primary stations (primary reference). 24 of 30 days have a city value. Method: City value per day = equal-weight mean of valid primary station-days (>= 16 valid IST hours; >= max(3, 50%) stations).", "clarifying_question": null, "data_types": ["measured"], "resolved_query": {"city": "Kolkata", "cities": ["Kolkata"], "pollutant": "PM2.5", "start_date": "2026-10-01", "end_date": "2026-10-30", "assumptions": ["relative to the latest data (2026-10-30)"], "items": [{"tool": "city_trend", "cities": ["Kolkata"], "pollutant": "PM2.5", "start": "2026-10-01", "end": "2026-10-30"}]}, "required_warnings": [], "model": "gemini-3.5-flash-lite", "verification": {"passed": true, "retries": 0, "numbers_checked": 6}}

