id: 7
event: answer
data: {"status": "answered", "text": "On Diwali 2025 (bulletin dates 2025-10-21 to 2025-10-22), Delhi's official CPCB AQI was in the Very Poor category with a festival AQI of 352, while pre-Diwali AQI was rising. We use official AQI (an index) for Diwali data.", "headline": "Delhi's air was Very Poor over Diwali 2025: the official CPCB AQI read 351 and 353 in the two festival bulletins (21–22 Oct 2025). Each bulletin runs from 4 PM to 4 PM.", "explanation": "Official CPCB AQI (index, not a concentration): Diwali air quality in Delhi (official AQI), 2025-10-06 to 2025-10-24. Stations chosen by CPCB for the city bulletin. Method: Festival days are Diwali (D) and D+1 (verified dates in events.json).", "clarifying_question": null, "data_types": ["official_aqi"], "resolved_query": {"city": "Delhi", "cities": ["Delhi"], "pollutant": "AQI (official CPCB)", "start_date": "2025-10-06", "end_date": "2025-10-24", "assumptions": ["Diwali 2025: festival bulletins D+1 and D+2 (CPCB 4 PM-to-4 PM)"], "items": [{"tool": "diwali_aqi", "cities": ["Delhi"], "pollutant": "AQI (official CPCB)", "start": "2025-10-06", "end": "2025-10-24"}]}, "required_warnings": [{"code": "aqi_not_concentration", "text": "Official AQI is an index of several pollutants, not a PM2.5 or PM10 concentration."}, {"code": "not_causal", "text": "Do not read this as Diwali causing the change: AQI often rises through October and November for seasonal reasons, and other weather and emission changes happen at the same time."}], "model": "gemini-3.5-flash-lite", "verification": {"passed": true, "retries": 1, "numbers_checked": 2}, "cached": true}

id: 8
