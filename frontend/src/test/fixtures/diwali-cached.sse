data: [{"label": "Delhi official AQI, Diwali 2025 (mean of festival bulletins)", "value": 352.0, "unit": "index (0-500)", "dataset_id": "ds1", "field": "2025_festival_aqi", "data_type": "official_aqi", "source": "CPCB daily AQI bulletin (via UrbanEmissions)", "warnings": ["This is official AQI (an index of several pollutants), not a PM2.5 or PM10 concentration.", "AQI was already rising in the days before Diwali, so the festival level cannot be attributed to Diwali alone."]}]

