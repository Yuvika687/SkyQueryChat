# Copy to .env.local for local runs. Never commit real values.

# Public: the browser calls the backend directly, so the backend sees each visitor's own IP
# (needed for per-visitor rate limits). This is a URL, not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only (no NEXT_PUBLIC_ prefix, never sent to the browser). Optional: enables the owner's
# demo pass at /demo, which forwards chats with X-Demo-Token. Must match the backend's DEMO_ACCESS_TOKEN.
DEMO_ACCESS_TOKEN=
# Server-only backend URL for the demo proxy (defaults to NEXT_PUBLIC_API_BASE_URL).
BACKEND_URL=
